   "source": [
    "# Load pre-computed SVI surrogate (qz) — used only for warm initialization.\n",
    "# LAPS can also run without qz by passing qz=None (initializes from prior).\n",
    "qz_data = jnp.load(\"qz.npz\")\n",
    "qz = tfd.MultivariateNormalTriL(loc=qz_data['loc'], scale_tril=qz_data['scale_tril'])\n",
    "print(\"qz distribution reconstructed successfully!\")"
   ]
  },
