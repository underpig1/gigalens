    "from importlib import reload\n",
    "import laps\n",
    "reload(laps)\n",
    "\n",
    "laps_samples = laps.LAPS(\n",
    "    model_seq=model_seq,\n",
    "    qz=qz,              # pass qz=None for cold start (N(0,1) in unconstrained space)\n",
    "    n_chains=16,\n",
    "    num_burnin_steps=1000,\n",
    "    num_results=2000,\n",
    "    mass_matrix_adapt=True,\n",
    "    progress_bar=True,\n",
    "    print_adapt_params=True,\n",
    "    seed=0,\n",
    ")\n",
    "print(f\"LAPS samples shape: {laps_samples.shape}\")"
   ]
